LOCAL_AI_TOKEN=replace-with-a-random-token
# ollama = local Gemma on the Jetson GPU (nothing leaves the Jetson).
# muse   = Meta Muse cloud API (prompts, customer data and OCR text are sent to api.meta.ai).
AI_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b-it-q4_K_M
OLLAMA_CONTEXT_LENGTH=4096
# Required only when AI_BACKEND=muse.
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.1
MUSE_REASONING_EFFORT=
MUSE_MIN_OUTPUT_TOKENS=2048
